FROM node:24-alpine AS frontend-builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM golang:1.26-alpine AS backend-builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend-builder /app/static /app/frontend/static
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -buildvcs=false -ldflags '-s -w' -o ovpn-admin

# openvpn-user: vendored upstream source (pashcovich/openvpn-user v1.0.9, commit 5eefd1b) built here, see third_party/openvpn-user/README.md.
# CGO is required by mattn/go-sqlite3. The build runs natively on every platform (buildx provides a builder per architecture).
FROM golang:1.26-alpine AS openvpn-user-builder
RUN apk add --no-cache gcc musl-dev
WORKDIR /src
COPY third_party/openvpn-user/go.mod third_party/openvpn-user/go.sum ./
RUN go mod download
COPY third_party/openvpn-user/ ./
RUN CGO_ENABLED=1 go build -trimpath -ldflags "-linkmode external -extldflags -static -s -w" -o /out/openvpn-user .

FROM alpine:3.23
WORKDIR /app
COPY --from=backend-builder /app/ovpn-admin /app
# sqlite: ovpn-admin fixes users.db rows migrated from openvpn-user <= 1.0.4 (secret IS NULL) at startup
RUN apk add --update bash easy-rsa openssl openvpn coreutils sqlite && \
    ln -s /usr/share/easy-rsa/easyrsa /usr/local/bin && \
    rm -rf /tmp/* /var/tmp/* /var/cache/apk/* /var/cache/distfiles/*
COPY --from=openvpn-user-builder /out/openvpn-user /usr/local/bin/openvpn-user
