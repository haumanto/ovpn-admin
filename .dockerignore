# IntelliJ project files
.idea
*.iml
out
gen
.github

easyrsa
easyrsa_master
easyrsa_slave
easyrsa_*
ccd
ccd_master
ccd_slave
# ccd_* is the host CCD state directories; the Go sources and tests named ccd_*.go stay in the build context
ccd_*
!ccd_*.go
# local state of both compose roles: PKI, keys, event log, ban state, admin audit trail, backups. Never part of a build context.
backups/
audit_master/
audit_slave/
state_master/
state_slave/
werf.yaml
frontend/node_modules
frontend/static/dist
openvpn-web-ui
openvpn-ui
openvpn-admin
ovpn-admin

docker-compose.yaml
docker-compose-slave.yaml
img
dashboard
.helm

# Secrets: OVPN_TELEGRAM_BOT_TOKEN must never be in the build context (COPY . . in Dockerfile.ovpn-admin would put an env file
# into a builder layer). Same patterns as .gitignore, also in subdirectories.
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
!.env.example
!**/.env.example
